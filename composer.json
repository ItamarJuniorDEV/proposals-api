{
    "name": "itamarjuniordev/proposal-api",
    "description": "API de orçamentos e propostas",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Itamar Junior",
            "email": "cdajuniorf@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.1"
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "format:check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "rector": "rector process --dry-run"
    }
}
